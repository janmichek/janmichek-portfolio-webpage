{
  "name": "janmichek",
  "niceName": "Jan Michek",
  "themeColor": "#78c4e4",
  "lang": "cs-CZ",
  "version": "1.0.0",
  "description": "Jan Michek's portfolio",
  "author": "janmichek",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "reinstall": "rm -rf ../node_modules && bun install",
    "reset": "bun reinstall && bun dev",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{css,scss,sass,vue}\"",
    "lint": "bun lint:js && bun lint:style",
    "lint:fix": "bun lint:js --fix && bun lint:style --fix",
    "deploy": "bun generate && firebase deploy",
    "emulators": "bun generate && firebase emulators:start"
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "0.14.0",
    "firebase": "12.17.1",
    "nuxt": "4.5.2",
    "nuxt-aos": "^1.2.6",
    "nuxt-vuefire": "1.1.2",
    "swiper": "14.0.7",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "vuefire": "3.2.3"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "4.0.0",
    "@nuxtjs/stylelint-module": "5.2.1",
    "postcss": "8.5.25",
    "postcss-apply-class": "0.1.6",
    "postcss-custom-media": "12.0.1",
    "postcss-nested": "8.0.1",
    "stylelint": "17.14.1",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0"
  },
  "simple-git-hooks": {
    "commit-msg": "bun lint:fix"
  }
}
