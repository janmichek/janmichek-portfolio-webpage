{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": false
  },
  "javascript": {
    "linter": {
      "enabled": false
    }
  },
  "css": {
    "linter": {
      "enabled": true
    }
  },
  "files": {
    "includes": ["**", "!**/coverage", "!**/.vercel", "!**/.output", "!**/.nuxt", "!**/dist"]
  }
}
