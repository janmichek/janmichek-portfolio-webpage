{
  "name": "janmichek",
  "niceName": "Jan Michek",
  "themeColor": "#78c4e4",
  "lang": "cs-CZ",
  "version": "1.0.0",
  "description": "Jan Michek's portfolio",
  "author": "janmichek",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "reinstall": "rm -rf ../node_modules && bun install",
    "reset": "bun reinstall && bun dev",
    "lint:js": "oxlint .",
    "lint:style": "biome lint .",
    "lint:css": "stylelint \"assets/styles/**/*.css\" \"app.vue\" \"components/**/*.vue\" \"layouts/**/*.vue\" \"pages/**/*.vue\"",
    "lint": "bun lint:js && bun lint:style && bun lint:css",
    "lint:fix": "bun lint:js --fix && biome lint --write . && stylelint --fix \"assets/styles/**/*.css\" \"app.vue\" \"components/**/*.vue\" \"layouts/**/*.vue\" \"pages/**/*.vue\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "bun generate",
    "check": "bun run lint && bun run test && fallow"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "nuxt-aos": "^1.2.6",
    "swiper": "14.0.7",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@csstools/postcss-global-data": "4.0.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "fallow": "3.38.0",
    "happy-dom": "21.0.4",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "8.5.25",
    "postcss-custom-media": "12.0.1",
    "postcss-html": "1.8.0",
    "postcss-nested": "8.0.1",
    "postcss-resolve-nested-selector": "0.1.6",
    "stylelint": "17.14.1",
    "stylelint-config-recommended": "18.0.0",
    "vitest": "5.0.5"
  },
  "simple-git-hooks": {
    "commit-msg": "bun lint:fix"
  }
}
