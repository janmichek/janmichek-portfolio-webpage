{
  "hosting": {
    "public": ".output/public",
    "site": "janmichek-4e7de",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Link",
            "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </sitemap.xml>; rel=\"describedby\"; type=\"application/xml\", </robots.txt>; rel=\"describedby\"; type=\"text/plain\""
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Link",
            "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </sitemap.xml>; rel=\"describedby\"; type=\"application/xml\", </robots.txt>; rel=\"describedby\"; type=\"text/plain\""
          }
        ]
      },
      {
        "source": "/.well-known/api-catalog",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
