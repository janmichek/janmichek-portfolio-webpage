{
  "name": "janmichek",
  "niceName": "Jan Michek",
  "themeColor": "#51c5a4",
  "lang": "cs-CZ",
  "version": "1.0.0",
  "description": "Jan Michek's portfolio",
  "author": "janmichek",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "reinstall": "rm -rf ../node_modules && yarn cache clean && yarn install",
    "reset": "yarn reinstall && yarn dev",
    "lint": "yarn lint:js && yarn lint:style",
    "lint:fix": "yarn lint:js --fix && yarn lint:style --fix",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"./**/*.vue\" \"**/*.css\"",
    "lint:st": "stylelint ./**/*.{vue}",
    "deploy": "yarn generate && firebase deploy",
    "emulators": "yarn generate && firebase emulators:start"
  },
  "dependencies": {
    "@nuxt/eslint": "1.9.0",
    "@nuxt/image": "^1.11.0",
    "@vueuse/head": "^2.0.0",
    "eslint": "^9.36.0",
    "firebase": "^12.3.0",
    "lost": "^9.0.2",
    "nuxt": "^4.1.2",
    "nuxt-vuefire": "1.1.0",
    "swiper": "^12.0.2",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vuefire": ">=3.2.2"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^3.1.0",
    "postcss": "^8.5.6",
    "postcss-custom-media": "^11.0.6",
    "postcss-html": "^1.8.0",
    "postcss-import": "^16.1.",
    "postcss-nested": "^7.0.2",
    "stylelint": "^16.24.0",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.0"
  },
